# PostgreSQL connection string used by the app.
# On Neon, use the *pooled* connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Random secret used to sign sessions. Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: direct (non-pooled) connection used only for running migrations.
# On Neon this is the same string without "-pooler" in the host.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
